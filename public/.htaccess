# Meridian Repute — static site config for cPanel / Apache
# Shipped in the site root by the Next.js static export (public/.htaccess).

Options -MultiViews -Indexes

RewriteEngine On

# Never redirect ACME / DCV validation requests — AutoSSL and Sectigo
# HTTP validation fetch plaintext files from here.
RewriteRule ^\.well-known/ - [L]

# TEMPORARY: apex is canonical because the cert does not yet cover www.
# Once the new cert lists both names, swap the second condition to
#   %{HTTP_HOST} ^meridianrepute\.com$
# and the target to https://www.meridianrepute.com to restore www-canonical.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.meridianrepute\.com$ [NC]
RewriteRule ^ https://meridianrepute.com%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html

<Files "opengraph-image">
  ForceType image/png
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Enable only after the cert is verified working on BOTH hostnames.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  <FilesMatch "\.(?:js|css|woff2?|svg|png|jpg|jpeg|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

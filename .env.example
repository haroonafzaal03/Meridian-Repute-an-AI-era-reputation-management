# Public site URL — used for canonical URLs, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.meridianrepute.com

# SMTP credentials for the consultation form (src/app/actions/consultation.ts).
# Most cPanel accounts can use a mailbox created under the same hosting
# package as an SMTP relay, e.g. host "mail.meridianrepute.com", port 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Inbox that consultation requests are delivered to (defaults to the
# address in src/lib/site-config.ts if unset).
CONSULTATION_TO_EMAIL=info@meridianrepute.com

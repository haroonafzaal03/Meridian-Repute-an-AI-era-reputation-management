# Public site URL — inlined at BUILD time into canonical URLs, sitemap, and
# JSON-LD. Defaults to https://www.meridianrepute.com if unset.
NEXT_PUBLIC_SITE_URL=https://www.meridianrepute.com

# The consultation form posts to /contact.php (public/contact.php), which sends
# email via PHP mail() on the cPanel host. There are no SMTP env vars — set the
# recipient in contact.php ($TO / $FROM). See DEPLOY.md.
